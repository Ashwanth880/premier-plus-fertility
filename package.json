{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/src/server.js",
    "admin:create": "node backend/src/create-admin.js",
    "db:migrate": "node backend/src/migrate.js",
    "db:import-json": "node backend/src/import-json.js",
    "test:backend": "node --test backend/test/*.test.js",
    "test": "npm run test:backend",
    "dev:frontend": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node backend/src/server.js",
    "preview": "vite preview",
    "predeploy": "vite build",
    "deploy": "npx gh-pages -d dist",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.14.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
